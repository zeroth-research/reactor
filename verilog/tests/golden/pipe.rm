module pipe
  external
    clk : bv1
    en : bv1
    x : bv8
    s1.q@init : bv8
    s2.q@init : bv4
  interface
    y1 : bv8
    y2 : bv4
    c1 : bv1
  private
    s2.en : bv1
    s2.d : bv4
    s2.changed : bv1
  atom controls y1 reads clk, en, x, y1 awaits clk, s1.q@init
    init
      X(y1) := ID X(s1.q@init)
    update
      %1 := NOT clk
      s1.clk@pos := AND (%1, X(clk))
      %2 := ITE (en, x, y1)
      X(y1) := ITE (s1.clk@pos, %2, y1)
  atom controls y2 reads clk, y2, s2.en, s2.d awaits clk, s2.q@init
    init
      X(y2) := ID X(s2.q@init)
    update
      %1 := NOT clk
      s2.clk@pos := AND (%1, X(clk))
      %2 := ITE (s2.en, s2.d, y2)
      X(y2) := ITE (s2.clk@pos, %2, y2)
  atom controls s2.d awaits x, y1
    init = update
      %1 := EXTRACT[3:0] X(y1)
      %2 := EXTRACT[3:0] X(x)
      X(s2.d) := ADD (%1, %2)
  atom controls c1 awaits x, y1
    init = update
      X(c1) := NE (X(y1), X(x))
  atom controls s2.changed awaits y2, s2.d
    init = update
      X(s2.changed) := NE (X(y2), X(s2.d))
  atom controls s2.en awaits en, c1
    init = update
      X(s2.en) := AND (X(en), X(c1))
