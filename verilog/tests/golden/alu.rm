module alu
  external
    op : bv2
    a : bv8
    b : bv8
  interface
    y : bv8
    zero : bv1
  atom controls y, zero awaits op, a, b
    init = update
      %1 := 2'd0
      %2 := EQ (X(op), %1)
      %3 := 2'd1
      %4 := EQ (X(op), %3)
      %5 := 2'd2
      %6 := EQ (X(op), %5)
      y@1 := ADD (X(a), X(b))
      y@2 := SUB (X(a), X(b))
      y@3 := AND (X(a), X(b))
      y@4 := XOR (X(a), X(b))
      y@5 := ITE (%6, y@3, y@4)
      y@6 := ITE (%4, y@2, y@5)
      y@7 := ITE (%2, y@1, y@6)
      %7 := 8'd0
      X(zero) := EQ (y@7, %7)
      X(y) := ID y@7
