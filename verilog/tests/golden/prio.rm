module prio
  external
    req : bv8
  interface
    idx : bv3
    valid : bv1
  atom controls idx, valid awaits req
    init = update
      idx@1 := 3'd0
      X(valid) := REDOR X(req)
      %1 := 8'd128
      %2 := ULE (%1, X(req))
      idx@2 := 3'd7
      %3 := 8'd64
      %4 := ULE (%3, X(req))
      idx@3 := 3'd6
      %5 := 8'd32
      %6 := ULE (%5, X(req))
      idx@4 := 3'd5
      %7 := 8'd16
      %8 := ULE (%7, X(req))
      idx@5 := 3'd4
      %9 := 8'd8
      %10 := ULE (%9, X(req))
      idx@6 := 3'd3
      %11 := 8'd4
      %12 := ULE (%11, X(req))
      idx@7 := 3'd2
      %13 := 8'd2
      %14 := ULE (%13, X(req))
      idx@8 := 3'd1
      idx@9 := ITE (%14, idx@8, idx@1)
      idx@10 := ITE (%12, idx@7, idx@9)
      idx@11 := ITE (%10, idx@6, idx@10)
      idx@12 := ITE (%8, idx@5, idx@11)
      idx@13 := ITE (%6, idx@4, idx@12)
      idx@14 := ITE (%4, idx@3, idx@13)
      X(idx) := ITE (%2, idx@2, idx@14)
