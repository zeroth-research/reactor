module arlow
  external
    clk : bv1
    rst_n : bv1
    d : bv4
    a@init : bv4
    s@init : bv2
    b@init : bv4
    n@init : bv4
  interface
    a : bv4
    b : bv4
    s : bv2
    n : bv4
  atom controls a, b, s reads clk, rst_n, d, a, b, s awaits clk, rst_n, a@init, s@init, b@init
    init
      %1 := NOT X(rst_n)
      %2 := 4'd0
      X(a) := ITE (%1, %2, X(a@init))
      %3 := 1'd0
      %4 := 1'd1
      %5 := CONCAT (%3, %4)
      X(s) := ITE (%1, %5, X(s@init))
      X(b) := ID X(b@init)
    update
      %6 := NOT clk
      clk@pos := AND (%6, X(clk))
      %7 := NOT rst_n
      %8 := 4'd0
      %9 := 1'd0
      %10 := 1'd1
      %11 := CONCAT (%9, %10)
      %12 := EXTRACT[0:0] s
      %13 := EXTRACT[1:1] s
      %14 := CONCAT (%12, %13)
      %15 := ITE (%7, %8, d)
      %16 := ITE (%7, %11, %14)
      %17 := ITE (%7, b, a)
      %18 := NOT X(rst_n)
      %19 := ITE (clk@pos, %15, a)
      %20 := 4'd0
      X(a) := ITE (%18, %20, %19)
      %21 := ITE (clk@pos, %16, s)
      %22 := 1'd0
      %23 := 1'd1
      %24 := CONCAT (%22, %23)
      X(s) := ITE (%18, %24, %21)
      X(b) := ITE (clk@pos, %17, b)
  atom controls n reads clk, rst_n, n awaits clk, rst_n, n@init
    init
      %1 := NOT X(rst_n)
      %2 := 4'd15
      X(n) := ITE (%1, %2, X(n@init))
    update
      %3 := NOT X(clk)
      clk@neg := AND (clk, %3)
      %4 := NOT rst_n
      %5 := 4'd15
      %6 := 4'd1
      %7 := SUB (n, %6)
      %8 := ITE (%4, %5, %7)
      %9 := NOT X(rst_n)
      %10 := ITE (clk@neg, %8, n)
      %11 := 4'd15
      X(n) := ITE (%9, %11, %10)
