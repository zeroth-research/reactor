module gray
  external
    b : bv8
  interface
    g : bv8
    back : bv8
  private
    t1 : bv8
    t2 : bv8
  atom controls g awaits b
    init = update
      %1 := 3'd1
      %2 := LSHR (X(b), %1)
      X(g) := XOR (X(b), %2)
  atom controls t1 awaits g
    init = update
      %1 := 3'd1
      %2 := LSHR (X(g), %1)
      X(t1) := XOR (X(g), %2)
  atom controls t2 awaits t1
    init = update
      %1 := 3'd2
      %2 := LSHR (X(t1), %1)
      X(t2) := XOR (X(t1), %2)
  atom controls back awaits t2
    init = update
      %1 := 3'd4
      %2 := LSHR (X(t2), %1)
      X(back) := XOR (X(t2), %2)
