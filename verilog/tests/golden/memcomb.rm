module memcomb
  external
    sel : bv2
    k : bv2
    d : bv4
    a : bv4
    c : bv4
  interface
    y : bv16
    z : bv4
    w : bv4
  private
    t[0] : bv4
    t[1] : bv4
    t[2] : bv4
    t[3] : bv4
    u[0] : bv4
    u[1] : bv4
  atom controls z, t[0], t[1], t[2], t[3] awaits sel, k, d, a
    init = update
      t[0]@1 := 4'd0
      t[1]@1 := 4'd0
      t[3]@1 := 4'd0
      %1 := 2'd0
      %2 := EQ (X(sel), %1)
      t[0]@2 := ITE (%2, X(d), t[0]@1)
      %3 := 2'd1
      %4 := EQ (X(sel), %3)
      t[1]@2 := ITE (%4, X(d), t[1]@1)
      %5 := 2'd2
      %6 := EQ (X(sel), %5)
      t[2]@1 := ITE (%6, X(d), X(a))
      %7 := 2'd3
      %8 := EQ (X(sel), %7)
      t[3]@2 := ITE (%8, X(d), t[3]@1)
      %9 := EXTRACT[0:0] X(k)
      %10 := ITE (%9, t[1]@2, t[0]@2)
      %11 := ITE (%9, t[3]@2, t[2]@1)
      %12 := EXTRACT[1:1] X(k)
      %13 := ITE (%12, %11, %10)
      X(z) := XOR (%13, t[2]@1)
      X(t[0]) := ID t[0]@2
      X(t[1]) := ID t[1]@2
      X(t[2]) := ID t[2]@1
      X(t[3]) := ID t[3]@2
  atom controls y awaits t[0], t[1], t[2], t[3]
    init = update
      %1 := CONCAT (X(t[1]), X(t[0]))
      %2 := CONCAT (X(t[2]), %1)
      X(y) := CONCAT (X(t[3]), %2)
  atom controls u[0], u[1] awaits a, c
    init = update
      %1 := CONCAT (X(c), X(a))
      X(u[1]) := EXTRACT[7:4] %1
      X(u[0]) := EXTRACT[3:0] %1
  atom controls w awaits k, u[0], u[1]
    init = update
      %1 := EXTRACT[0:0] X(k)
      X(w) := ITE (%1, X(u[1]), X(u[0]))
