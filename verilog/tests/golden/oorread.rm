module oorread
  external
    clk : bv1
    c : bv6
    i : bv4
    v : bv16
    mem[0]@init : bv6
    mem[1]@init : bv6
    mem[2]@init : bv6
    mem[3]@init : bv6
    q@init : bv1
  interface
    b : bv1
    up : bv4
    dn : bv4
    e : bv3
    q : bv1
  private
    k : bv16
    mem[0] : bv6
    mem[1] : bv6
    mem[2] : bv6
    mem[3] : bv6
  atom controls b awaits c, v
    init = update
      %1 := 32'd15
      %2 := ZEXT[32] X(c)
      %3 := SUB (%1, %2)
      %4 := LSHR (X(v), %3)
      X(b) := EXTRACT[0:0] %4
  atom controls up awaits i, v
    init = update
      %1 := 1'd0
      %2 := CONCAT (%1, X(i))
      %3 := 5'd10
      %4 := ADD (%2, %3)
      %5 := LSHR (X(v), %4)
      X(up) := EXTRACT[3:0] %5
  atom controls dn awaits i, v
    init = update
      %1 := 3'd0
      %2 := CONCAT (X(v), %1)
      %3 := LSHR (%2, X(i))
      X(dn) := EXTRACT[3:0] %3
  atom controls q, mem[0], mem[1], mem[2], mem[3] reads clk, c, i, v, q, k, mem[0], mem[1], mem[2], mem[3] awaits clk, mem[0]@init, mem[1]@init, mem[2]@init, mem[3]@init, q@init
    init
      X(mem[0]) := ID X(mem[0]@init)
      X(mem[1]) := ID X(mem[1]@init)
      X(mem[2]) := ID X(mem[2]@init)
      X(mem[3]) := ID X(mem[3]@init)
      X(q) := ID X(q@init)
    update
      %1 := NOT clk
      clk@pos := AND (%1, X(clk))
      %2 := EXTRACT[5:0] v
      %3 := EXTRACT[1:0] i
      %4 := 2'd0
      %5 := EQ (%3, %4)
      %6 := ITE (%5, %2, mem[0])
      %7 := 2'd1
      %8 := EQ (%3, %7)
      %9 := ITE (%8, %2, mem[1])
      %10 := 2'd2
      %11 := EQ (%3, %10)
      %12 := ITE (%11, %2, mem[2])
      %13 := 2'd3
      %14 := EQ (%3, %13)
      %15 := ITE (%14, %2, mem[3])
      %16 := 32'd15
      %17 := ZEXT[32] c
      %18 := SUB (%16, %17)
      %19 := LSHR (k, %18)
      %20 := EXTRACT[0:0] %19
      X(mem[0]) := ITE (clk@pos, %6, mem[0])
      X(mem[1]) := ITE (clk@pos, %9, mem[1])
      X(mem[2]) := ITE (clk@pos, %12, mem[2])
      X(mem[3]) := ITE (clk@pos, %15, mem[3])
      X(q) := ITE (clk@pos, %20, q)
  atom controls e awaits c, mem[0], mem[1], mem[2], mem[3]
    init = update
      %1 := EXTRACT[1:0] X(c)
      %2 := EXTRACT[0:0] %1
      %3 := ITE (%2, X(mem[1]), X(mem[0]))
      %4 := ITE (%2, X(mem[3]), X(mem[2]))
      %5 := EXTRACT[1:1] %1
      %6 := ITE (%5, %4, %3)
      %7 := EXTRACT[5:2] X(c)
      %8 := 2'd0
      %9 := CONCAT (%6, %8)
      %10 := LSHR (%9, %7)
      X(e) := EXTRACT[2:0] %10
  atom controls k
    init = update
      %1 := 15'd14635
      %2 := 1'd0
      X(k) := CONCAT (%1, %2)
