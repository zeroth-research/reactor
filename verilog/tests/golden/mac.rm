module mac
  external
    clk : bv1
    clear : bv1
    a : bv8
    b : bv8
    acc@init : bv16
  interface
    acc : bv16
    hi : bv8
  atom controls acc reads clk, clear, a, b, acc awaits clk, acc@init
    init
      X(acc) := ID X(acc@init)
    update
      %1 := NOT clk
      clk@pos := AND (%1, X(clk))
      %2 := 16'd0
      %3 := SEXT[16] a
      %4 := SEXT[16] b
      %5 := MUL (%3, %4)
      %6 := ADD (acc, %5)
      %7 := ITE (clear, %2, %6)
      X(acc) := ITE (clk@pos, %7, acc)
  atom controls hi awaits acc
    init = update
      X(hi) := EXTRACT[15:8] X(acc)
