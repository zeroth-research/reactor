module modcount
  external
    en : bv1
    q@init : bv4
  interface
    q : bv4
    wrap : bv1
  atom controls q reads en, q, wrap awaits q@init
    init
      X(q) := ID X(q@init)
    update
      %1 := 4'd0
      %2 := 4'd1
      %3 := ADD (q, %2)
      %4 := ITE (wrap, %1, %3)
      X(q) := ITE (en, %4, q)
  atom controls wrap awaits q
    init = update
      %1 := 4'd9
      X(wrap) := EQ (X(q), %1)
