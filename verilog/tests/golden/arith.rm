module arith
  external
    a : bv8
    b : bv8
    c : bv8
    s : bv8
    t : bv8
  interface
    r : bv8
    q : bv8
    big : bv1
  atom controls r awaits a, b, c
    init = update
      %1 := MUL (X(a), X(b))
      %2 := ADD (%1, X(c))
      X(r) := SUB (%2, X(a))
  atom controls q awaits s, t
    init = update
      %1 := NEG X(s)
      %2 := MUL (%1, X(t))
      X(q) := ADD (%2, X(s))
  atom controls big awaits a, b, c, s, t
    init = update
      %1 := ADD (X(a), X(b))
      %2 := ULT (X(c), %1)
      %3 := SLT (X(s), X(t))
      %4 := 8'd0
      %5 := NE (X(a), %4)
      %6 := AND (%3, %5)
      %7 := OR (%2, %6)
      %8 := 1'd1
      %9 := 1'd0
      X(big) := ITE (%7, %8, %9)
