module mux4
  external
    sel : bv2
    k : bv3
    d : bv4
    w : bv16
  interface
    y : bv1
    y1 : bv1
    win : bv4
    nib : bv4
    top : bv4
  atom controls y awaits sel, d
    init = update
      %1 := LSHR (X(d), X(sel))
      X(y) := EXTRACT[0:0] %1
  atom controls y1 awaits sel, d
    init = update
      %1 := LSHR (X(d), X(sel))
      X(y1) := EXTRACT[0:0] %1
  atom controls win awaits k, w
    init = update
      %1 := LSHR (X(w), X(k))
      X(win) := EXTRACT[3:0] %1
  atom controls nib awaits sel, w
    init = update
      %1 := 2'd0
      %2 := CONCAT (X(sel), %1)
      %3 := LSHR (X(w), %2)
      X(nib) := EXTRACT[3:0] %3
  atom controls top awaits w
    init = update
      X(top) := EXTRACT[15:12] X(w)
