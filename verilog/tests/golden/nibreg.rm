module nibreg
  external
    clk : bv1
    we : bv2
    d : bv4
    r@init : bv8
  interface
    r : bv8
    flags : bv4
  atom controls r reads clk, we, d, r awaits clk, r@init
    init
      X(r) := ID X(r@init)
    update
      %1 := NOT clk
      clk@pos := AND (%1, X(clk))
      %2 := EXTRACT[0:0] we
      %3 := EXTRACT[3:0] r
      %4 := ITE (%2, d, %3)
      %5 := EXTRACT[1:1] we
      %6 := EXTRACT[7:4] r
      %7 := ITE (%5, d, %6)
      %8 := CONCAT (%7, %4)
      X(r) := ITE (clk@pos, %8, r)
  atom controls flags awaits r
    init = update
      %1 := 8'd0
      %2 := EQ (X(r), %1)
      %3 := EXTRACT[7:7] X(r)
      %4 := REDXOR X(r)
      %5 := CONCAT (%3, %2)
      %6 := CONCAT (%4, %5)
      %7 := REDOR %6
      X(flags) := CONCAT (%7, %6)
