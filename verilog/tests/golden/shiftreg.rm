module shiftreg
  external
    clk : bv1
    d : bv8
    s1@init : bv8
    s2@init : bv8
    s3@init : bv8
    q@init : bv8
  interface
    q : bv8
  private
    s1 : bv8
    s2 : bv8
    s3 : bv8
  atom controls q, s1, s2, s3 reads clk, d, q, s1, s2, s3 awaits clk, s1@init, s2@init, s3@init, q@init
    init
      X(s1) := ID X(s1@init)
      X(s2) := ID X(s2@init)
      X(s3) := ID X(s3@init)
      X(q) := ID X(q@init)
    update
      %1 := NOT clk
      clk@pos := AND (%1, X(clk))
      X(s1) := ITE (clk@pos, d, s1)
      X(s2) := ITE (clk@pos, s1, s2)
      X(s3) := ITE (clk@pos, s2, s3)
      X(q) := ITE (clk@pos, s3, q)
