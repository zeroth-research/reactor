module traffic
  external
    clk : bv1
    rst : bv1
    state@init : bv2
    timer@init : bv3
  interface
    light : bv2
    walk : bv1
  private
    state : bv2
    timer : bv3
    done : bv1
  atom controls state, timer reads clk, rst, state, timer, done awaits clk, state@init, timer@init
    init
      X(state) := ID X(state@init)
      X(timer) := ID X(timer@init)
    update
      %1 := NOT clk
      clk@pos := AND (%1, X(clk))
      %2 := 2'd0
      %3 := 3'd0
      %4 := 3'd0
      %5 := 2'd0
      %6 := EQ (state, %5)
      %7 := 2'd1
      %8 := EQ (state, %7)
      %9 := 2'd1
      %10 := 2'd2
      %11 := 2'd0
      %12 := ITE (%8, %10, %11)
      %13 := ITE (%6, %9, %12)
      %14 := 3'd1
      %15 := ADD (timer, %14)
      %16 := ITE (done, %13, state)
      %17 := ITE (done, %4, %15)
      %18 := ITE (rst, %2, %16)
      %19 := ITE (rst, %3, %17)
      X(state) := ITE (clk@pos, %18, state)
      X(timer) := ITE (clk@pos, %19, timer)
  atom controls done awaits state, timer
    init = update
      %1 := 2'd0
      %2 := EQ (X(state), %1)
      %3 := 2'd1
      %4 := EQ (X(state), %3)
      %5 := 3'd3
      done@1 := EQ (X(timer), %5)
      %6 := 3'd0
      done@2 := EQ (X(timer), %6)
      %7 := 3'd2
      done@3 := EQ (X(timer), %7)
      done@4 := ITE (%4, done@2, done@3)
      X(done) := ITE (%2, done@1, done@4)
  atom controls light awaits state
    init = update
      X(light) := ID X(state)
  atom controls walk awaits state
    init = update
      %1 := 2'd2
      X(walk) := EQ (X(state), %1)
