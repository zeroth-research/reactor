module traffic
  external
    rst : bv1
    state@init : bv2
    timer@init : bv3
  interface
    light : bv2
    walk : bv1
  private
    state : bv2
    timer : bv3
    done : bv1
  atom controls state, timer reads rst, state, timer, done awaits state@init, timer@init
    init
      X(state) := ID X(state@init)
      X(timer) := ID X(timer@init)
    update
      %1 := 2'd0
      %2 := 3'd0
      %3 := 3'd0
      %4 := 2'd0
      %5 := EQ (state, %4)
      %6 := 2'd1
      %7 := EQ (state, %6)
      %8 := 2'd1
      %9 := 2'd2
      %10 := 2'd0
      %11 := ITE (%7, %9, %10)
      %12 := ITE (%5, %8, %11)
      %13 := 3'd1
      %14 := ADD (timer, %13)
      %15 := ITE (done, %12, state)
      %16 := ITE (done, %3, %14)
      X(state) := ITE (rst, %1, %15)
      X(timer) := ITE (rst, %2, %16)
  atom controls done awaits state, timer
    init = update
      %1 := 2'd0
      %2 := EQ (X(state), %1)
      %3 := 2'd1
      %4 := EQ (X(state), %3)
      %5 := 3'd3
      done@1 := EQ (X(timer), %5)
      %6 := 3'd0
      done@2 := EQ (X(timer), %6)
      %7 := 3'd2
      done@3 := EQ (X(timer), %7)
      done@4 := ITE (%4, done@2, done@3)
      X(done) := ITE (%2, done@1, done@4)
  atom controls light awaits state
    init = update
      X(light) := ID X(state)
  atom controls walk awaits state
    init = update
      %1 := 2'd2
      X(walk) := EQ (X(state), %1)
