module decode
  external
    clk : bv1
    cmd : bv3
    d : bv8
    q@init : bv8
  interface
    q : bv8
  atom controls q reads clk, cmd, d, q awaits clk, q@init
    init
      X(q) := ID X(q@init)
    update
      %1 := NOT clk
      clk@pos := AND (%1, X(clk))
      %2 := 3'd0
      %3 := EQ (cmd, %2)
      %4 := 3'd1
      %5 := EQ (cmd, %4)
      %6 := 3'd2
      %7 := EQ (cmd, %6)
      %8 := OR (%5, %7)
      %9 := 3'd3
      %10 := EQ (cmd, %9)
      %11 := 3'd4
      %12 := EQ (cmd, %11)
      %13 := 3'd0
      %14 := EQ (cmd, %13)
      %15 := OR (%12, %14)
      %16 := 8'd0
      %17 := 8'd1
      %18 := ADD (q, %17)
      %19 := 8'd1
      %20 := SUB (q, %19)
      %21 := ITE (%15, %20, q)
      %22 := ITE (%10, %18, %21)
      %23 := ITE (%8, d, %22)
      %24 := ITE (%3, %16, %23)
      X(q) := ITE (clk@pos, %24, q)
