module decode
  external
    cmd : bv3
    d : bv8
    q@init : bv8
  interface
    q : bv8
  atom controls q reads cmd, d, q awaits q@init
    init
      X(q) := ID X(q@init)
    update
      %1 := 3'd0
      %2 := EQ (cmd, %1)
      %3 := 3'd1
      %4 := EQ (cmd, %3)
      %5 := 3'd2
      %6 := EQ (cmd, %5)
      %7 := OR (%4, %6)
      %8 := 3'd3
      %9 := EQ (cmd, %8)
      %10 := 3'd4
      %11 := EQ (cmd, %10)
      %12 := 3'd0
      %13 := EQ (cmd, %12)
      %14 := OR (%11, %13)
      %15 := 8'd0
      %16 := 8'd1
      %17 := ADD (q, %16)
      %18 := 8'd1
      %19 := SUB (q, %18)
      %20 := ITE (%14, %19, q)
      %21 := ITE (%9, %17, %20)
      %22 := ITE (%7, d, %21)
      X(q) := ITE (%2, %15, %22)
