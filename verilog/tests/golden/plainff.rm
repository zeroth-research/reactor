module plainff
  external
    clk : bv1
    rst_n : bv1
    en : bv1
    d : bv4
    cnt@init : bv4
    low@init : bv4
    hist[0]@init : bv4
    hist[1]@init : bv4
  interface
    cnt : bv4
    low : bv4
    seen : bv1
  private
    hist[0] : bv4
    hist[1] : bv4
  atom controls cnt reads clk, rst_n, en, cnt awaits clk, rst_n, cnt@init
    init
      %1 := NOT X(rst_n)
      %2 := 4'd0
      X(cnt) := ITE (%1, %2, X(cnt@init))
    update
      %3 := NOT clk
      clk@pos := AND (%3, X(clk))
      %4 := NOT rst_n
      %5 := 4'd0
      %6 := 4'd1
      %7 := ADD (cnt, %6)
      %8 := ITE (en, %7, cnt)
      %9 := ITE (%4, %5, %8)
      %10 := NOT X(rst_n)
      %11 := ITE (clk@pos, %9, cnt)
      %12 := 4'd0
      X(cnt) := ITE (%10, %12, %11)
  atom controls low, hist[0], hist[1] reads clk, d, cnt, low, hist[0], hist[1] awaits clk, low@init, hist[0]@init, hist[1]@init
    init
      X(low) := ID X(low@init)
      X(hist[0]) := ID X(hist[0]@init)
      X(hist[1]) := ID X(hist[1]@init)
    update
      %1 := NOT X(clk)
      clk@neg := AND (clk, %1)
      %2 := EXTRACT[0:0] d
      %3 := 1'd0
      %4 := EQ (%2, %3)
      %5 := ITE (%4, cnt, hist[0])
      %6 := 1'd1
      %7 := EQ (%2, %6)
      %8 := ITE (%7, cnt, hist[1])
      X(low) := ITE (clk@neg, d, low)
      X(hist[0]) := ITE (clk@neg, %5, hist[0])
      X(hist[1]) := ITE (clk@neg, %8, hist[1])
  atom controls seen reads clk, seen, hist[0], hist[1] awaits clk
    init
      X(seen) := 1'd0
    update
      %1 := NOT clk
      clk@pos#2 := AND (%1, X(clk))
      %2 := EQ (hist[0], hist[1])
      %3 := OR (seen, %2)
      X(seen) := ITE (clk@pos#2, %3, seen)
