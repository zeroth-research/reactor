module enreg
  external
    clk : bv1
    rst : bv1
    load : bv1
    inc : bv1
    d : bv8
    changed@init : bv1
    q@init : bv8
  interface
    q : bv8
    changed : bv1
  atom controls q, changed reads clk, rst, load, inc, d, q, changed awaits clk, changed@init, q@init
    init
      X(changed) := ID X(changed@init)
      X(q) := ID X(q@init)
    update
      %1 := NOT clk
      clk@pos := AND (%1, X(clk))
      %2 := 1'd0
      %3 := 8'd0
      %4 := 8'd0
      %5 := NE (q, %4)
      %6 := NE (q, d)
      %7 := 8'd1
      %8 := ADD (q, %7)
      %9 := 1'd1
      %10 := ITE (inc, %9, %2)
      %11 := ITE (inc, %8, q)
      %12 := ITE (load, %6, %10)
      %13 := ITE (load, d, %11)
      %14 := ITE (rst, %5, %12)
      %15 := ITE (rst, %3, %13)
      X(changed) := ITE (clk@pos, %14, changed)
      X(q) := ITE (clk@pos, %15, q)
