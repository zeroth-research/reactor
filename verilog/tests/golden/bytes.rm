module bytes
  external
    w : bv16
    b : bv8
    s : bv8
  interface
    swapped : bv16
    ext_b : bv16
    ext_s : bv16
    same : bv1
  atom controls swapped awaits w
    init = update
      %1 := EXTRACT[7:0] X(w)
      %2 := EXTRACT[15:8] X(w)
      X(swapped) := CONCAT (%1, %2)
  atom controls ext_b awaits b
    init = update
      %1 := EXTRACT[7:7] X(b)
      %2 := CONCAT (%1, %1)
      %3 := CONCAT (%1, %2)
      %4 := CONCAT (%1, %3)
      %5 := CONCAT (%1, %4)
      %6 := CONCAT (%1, %5)
      %7 := CONCAT (%1, %6)
      %8 := CONCAT (%1, %7)
      X(ext_b) := CONCAT (%8, X(b))
  atom controls ext_s awaits s
    init = update
      X(ext_s) := SEXT[16] X(s)
  atom controls same awaits b, ext_b
    init = update
      %1 := SEXT[16] X(b)
      X(same) := EQ (X(ext_b), %1)
