module memoor
  external
    clk : bv1
    i : bv3
    j : bv2
    d : bv4
    m[0]@init : bv4
    m[1]@init : bv4
    m[2]@init : bv4
    m[3]@init : bv4
    m[4]@init : bv4
    m[5]@init : bv4
  interface
    x : bv4
    y : bv4
    z : bv4
  private
    m[0] : bv4
    m[1] : bv4
    m[2] : bv4
    m[3] : bv4
    m[4] : bv4
    m[5] : bv4
  atom controls m[0], m[1], m[2], m[3], m[4], m[5] reads clk, i, d, m[0], m[1], m[2], m[3], m[4], m[5] awaits clk, m[0]@init, m[1]@init, m[2]@init, m[3]@init, m[4]@init, m[5]@init
    init
      X(m[0]) := ID X(m[0]@init)
      X(m[1]) := ID X(m[1]@init)
      X(m[2]) := ID X(m[2]@init)
      X(m[3]) := ID X(m[3]@init)
      X(m[4]) := ID X(m[4]@init)
      X(m[5]) := ID X(m[5]@init)
    update
      %1 := NOT clk
      clk@pos := AND (%1, X(clk))
      %2 := 3'd0
      %3 := EQ (i, %2)
      %4 := ITE (%3, d, m[0])
      %5 := 3'd1
      %6 := EQ (i, %5)
      %7 := ITE (%6, d, m[1])
      %8 := 3'd2
      %9 := EQ (i, %8)
      %10 := ITE (%9, d, m[2])
      %11 := 3'd3
      %12 := EQ (i, %11)
      %13 := ITE (%12, d, m[3])
      %14 := 3'd4
      %15 := EQ (i, %14)
      %16 := ITE (%15, d, m[4])
      %17 := 3'd5
      %18 := EQ (i, %17)
      %19 := ITE (%18, d, m[5])
      X(m[0]) := ITE (clk@pos, %4, m[0])
      X(m[1]) := ITE (clk@pos, %7, m[1])
      X(m[2]) := ITE (clk@pos, %10, m[2])
      X(m[3]) := ITE (clk@pos, %13, m[3])
      X(m[4]) := ITE (clk@pos, %16, m[4])
      X(m[5]) := ITE (clk@pos, %19, m[5])
  atom controls x awaits j, m[0], m[1], m[2], m[3]
    init = update
      %1 := EXTRACT[0:0] X(j)
      %2 := ITE (%1, X(m[1]), X(m[0]))
      %3 := ITE (%1, X(m[3]), X(m[2]))
      %4 := EXTRACT[1:1] X(j)
      X(x) := ITE (%4, %3, %2)
  atom controls y awaits m[5]
    init = update
      X(y) := ID X(m[5])
  atom controls z awaits j, m[0], m[1], m[2], m[3], m[4]
    init = update
      %1 := 1'd0
      %2 := EXTRACT[0:0] X(j)
      %3 := CONCAT (%1, %2)
      %4 := EXTRACT[0:0] %3
      %5 := ITE (%4, X(m[1]), X(m[0]))
      %6 := ITE (%4, X(m[3]), X(m[2]))
      %7 := EXTRACT[1:1] %3
      %8 := ITE (%7, %6, %5)
      X(z) := OR (X(m[4]), %8)
