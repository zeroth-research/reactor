import Relational.ReactiveTS
import Relational.ProofRules
import Certificate.Module

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

theorem init_inv_proof : ∀ s, RM.init_pre s → inv (RM.init s) := by
  sorry

theorem step_inv_proof : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  sorry

theorem inv_imp_P_proof : ∀ s, inv s → P s := by
  sorry

=== Certificate/Certificate.lean
import Relational.ReactiveTS
import Relational.ProofRules
import Certificate.Module
import Certificate.Proofs

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

noncomputable section

theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
  exact init_inv_proof

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  exact step_inv_proof

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [ReactiveTS.toTS, ReactiveTS.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [ReactiveTS.toTS, ReactiveTS.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

-- `G P`. The invariant does the work; all that is left is that it is a
-- *strengthening* of the property. `StateSet_isInvariant` is
-- `reachableSet ⊆ ·`, so a superset of an invariant is invariant too, and
-- `rule_globally` turns that into `G (AP P)` on every trace.
theorem inv_imp_P : ∀ s, inv s → P s := by
  exact inv_imp_P_proof

theorem hP : lts.StateSet_isInvariant P := by
  intro s hs
  exact inv_imp_P s (hinv hs)

def safety := rule_globally
  lts
  P
  hP

end

=== standalone
import Relational.ReactiveTS
import Relational.ProofRules

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false



namespace Atom0

@[simp] def init (extl_n: (Matrix (Fin 1) (Fin 1) Int)) : (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Bool) :=
  let x0 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (0 : Int))
  let x1 : (Matrix (Fin 1) (Fin 1) Bool) := (Matrix.mk fun _ _ => false)
  (x0, x1)

@[simp] def update (ctrl: (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Bool) × (Matrix (Fin 1) (Fin 1) Int)) (extl_l: (Matrix (Fin 1) (Fin 1) Int)) (extl_n: (Matrix (Fin 1) (Fin 1) Int)) : (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Bool) :=
  let x0 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (1 : Int))
  let x1 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (4 : Int))
  let x2 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (0 : Int))
  let x3 : (Matrix (Fin 1) (Fin 1) Int) := (ctrl.2.1 + x0)
  let x4 : (Matrix (Fin 1) (Fin 1) Bool) := (Matrix.mk fun _ _ => decide (x3 0 0 = x1 0 0))
  let x5 : (Matrix (Fin 1) (Fin 1) Int) := (if x4 0 0 then x2 else x3)
  let x6 : (Matrix (Fin 1) (Fin 1) Bool) := x4
  (x5, x6)

end Atom0

namespace Atom1

@[simp] def init (extl_n: (Matrix (Fin 1) (Fin 1) Int)) (wait: (Matrix (Fin 1) (Fin 1) Int)) : (Matrix (Fin 1) (Fin 1) Int) :=
  let x0 : (Matrix (Fin 1) (Fin 1) Int) := wait
  x0

@[simp] def update (ctrl: (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Bool) × (Matrix (Fin 1) (Fin 1) Int)) (extl_l: (Matrix (Fin 1) (Fin 1) Int)) (extl_n: (Matrix (Fin 1) (Fin 1) Int)) (wait: (Matrix (Fin 1) (Fin 1) Int)) : (Matrix (Fin 1) (Fin 1) Int) :=
  let x0 : (Matrix (Fin 1) (Fin 1) Int) := (ctrl.2.2.2 + wait)
  x0

end Atom1

namespace Atom2

@[simp] def init (extl_n: (Matrix (Fin 1) (Fin 1) Int)) (wait: (Matrix (Fin 1) (Fin 1) Int)) : (Matrix (Fin 1) (Fin 1) Int) :=
  let x0 : (Matrix (Fin 1) (Fin 1) Int) := (wait - extl_n)
  x0

@[simp] def update (ctrl: (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Bool) × (Matrix (Fin 1) (Fin 1) Int)) (extl_l: (Matrix (Fin 1) (Fin 1) Int)) (extl_n: (Matrix (Fin 1) (Fin 1) Int)) (wait: (Matrix (Fin 1) (Fin 1) Int)) : (Matrix (Fin 1) (Fin 1) Int) :=
  let x0 : (Matrix (Fin 1) (Fin 1) Int) := (wait - extl_n)
  x0

end Atom2

@[simp] def init (extl_n: (Matrix (Fin 1) (Fin 1) Int)) : (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Bool) × (Matrix (Fin 1) (Fin 1) Int) :=
  let a0 := Atom0.init extl_n
  let a1 := Atom1.init extl_n a0.1
  let a2 := Atom2.init extl_n a1
  (a2, a0.1, a0.2, a1)

@[simp] def update (ctrl: (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Bool) × (Matrix (Fin 1) (Fin 1) Int)) (extl_l: (Matrix (Fin 1) (Fin 1) Int)) (extl_n: (Matrix (Fin 1) (Fin 1) Int)) : (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Bool) × (Matrix (Fin 1) (Fin 1) Int) :=
  let a0 := Atom0.update ctrl extl_l extl_n
  let a1 := Atom1.update ctrl extl_l extl_n a0.1
  let a2 := Atom2.update ctrl extl_l extl_n a1
  (a2, a0.1, a0.2, a1)


def init_pre (e : ((Matrix (Fin 1) (Fin 1) Int)) × ((Matrix (Fin 1) (Fin 1) Int))) : Prop := True

def update_pre (e : ((Matrix (Fin 1) (Fin 1) Int)) × ((Matrix (Fin 1) (Fin 1) Int))) : Prop := True

def inv : (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Bool) × (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => (((s.2.1 0 0) ≥ (0 : Int)) ∧ ((s.2.1 0 0) ≤ (3 : Int)) ∧ ((s.2.2.2 0 0) ≥ (0 : Int)))

def P : (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Int) × (Matrix (Fin 1) (Fin 1) Bool) × (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => ((s.2.1 0 0) ≤ (3 : Int))

instance : DecidablePred P := fun s => by unfold P; first | infer_instance | dsimp; infer_instance

noncomputable section

def RM := ({
    init := fun e => init e.2
    update := fun x e => update x e.1 e.2
    init_pre := init_pre
    update_pre := update_pre
} : ReactiveTS _ _)

def lts := RM.toTS

end

theorem init_inv_proof : ∀ s, RM.init_pre s → inv (RM.init s) := by
  sorry

theorem step_inv_proof : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  sorry

theorem inv_imp_P_proof : ∀ s, inv s → P s := by
  sorry

noncomputable section

theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
  exact init_inv_proof

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  exact step_inv_proof

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [ReactiveTS.toTS, ReactiveTS.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [ReactiveTS.toTS, ReactiveTS.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

-- `G P`. The invariant does the work; all that is left is that it is a
-- *strengthening* of the property. `StateSet_isInvariant` is
-- `reachableSet ⊆ ·`, so a superset of an invariant is invariant too, and
-- `rule_globally` turns that into `G (AP P)` on every trace.
theorem inv_imp_P : ∀ s, inv s → P s := by
  exact inv_imp_P_proof

theorem hP : lts.StateSet_isInvariant P := by
  intro s hs
  exact inv_imp_P s (hinv hs)

def safety := rule_globally
  lts
  P
  hP

end
