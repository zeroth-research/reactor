=== Certificate/Data.lean
import Relational.Basic

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

def init_pre (e : (Unit) × (Unit)) : Prop := True

def update_pre (e : (Unit) × (Unit)) : Prop := True

def inv : (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => (((s 0 0) ≥ (0 : Int)) ∧ ((s 0 0) ≤ (100 : Int)))

def P : (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => ((s 0 0) = (0 : Int))

instance : DecidablePred P := fun s => by unfold P; first | infer_instance | dsimp; infer_instance

def ranking : (Matrix (Fin 1) (Fin 1) Int) → Nat := fun s => (((if ((s 0 0) = (0 : Int)) then (0 : Int) else (s 0 0)) : Int)).toNat

=== Certificate/Module.lean
import Relational.Basic
import System.System
import Certificate.Data

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

noncomputable section

def RM := ({
    init := fun e => init e.2
    update := fun x e => update x e.1 e.2
    init_pre := init_pre
    update_pre := update_pre
} : ReactiveModule _ _)

def lts := RM.toTS

end

=== Certificate/Proofs.lean
import Relational.Basic
import Certificate.Module

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

theorem init_inv_proof : ∀ s, RM.init_pre s → inv (RM.init s) := by
  sorry

theorem step_inv_proof : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  sorry

theorem hrank_proof : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
  sorry

=== Certificate/Certificate.lean
import Relational.Basic
import Certificate.Module
import Certificate.Proofs

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

noncomputable section

theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
  exact init_inv_proof

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  exact step_inv_proof

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [ReactiveModule.toTS, ReactiveModule.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [ReactiveModule.toTS, ReactiveModule.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

theorem hrank : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
  exact hrank_proof

def buchi := rule_buchi
  lts
  P
  inv
  hinv
  ranking
  hrank

end

=== standalone
import Relational.Basic
import Relational.Circ

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false



@[simp] def init (extl_n: Unit) : (Matrix (Fin 1) (Fin 1) Int) :=
  let x0 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (100 : Int))
  let x1 : (Matrix (Fin 1) (Fin 1) Int) := x0
  x1

@[simp] def update (ctrl: (Matrix (Fin 1) (Fin 1) Int)) (extl_l: Unit) (extl_n: Unit) : (Matrix (Fin 1) (Fin 1) Int) :=
  let x0 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (0 : Int))
  let x1 : (Matrix (Fin 1) (Fin 1) Bool) := (Matrix.mk fun _ _ => decide (ctrl 0 0 = x0 0 0))
  let x2 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (100 : Int))
  let x3 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (1 : Int))
  let x4 : (Matrix (Fin 1) (Fin 1) Int) := (ctrl - x3)
  let x5 : (Matrix (Fin 1) (Fin 1) Int) := (if x1 0 0 then x2 else x4)
  let x6 : (Matrix (Fin 1) (Fin 1) Int) := x5
  x6


def init_pre (e : (Unit) × (Unit)) : Prop := True

def update_pre (e : (Unit) × (Unit)) : Prop := True

def inv : (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => (((s 0 0) ≥ (0 : Int)) ∧ ((s 0 0) ≤ (100 : Int)))

def P : (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => ((s 0 0) = (0 : Int))

instance : DecidablePred P := fun s => by unfold P; first | infer_instance | dsimp; infer_instance

def ranking : (Matrix (Fin 1) (Fin 1) Int) → Nat := fun s => (((if ((s 0 0) = (0 : Int)) then (0 : Int) else (s 0 0)) : Int)).toNat

noncomputable section

def RM := ({
    init := fun e => init e.2
    update := fun x e => update x e.1 e.2
    init_pre := init_pre
    update_pre := update_pre
} : ReactiveModule _ _)

def lts := RM.toTS

end

theorem init_inv_proof : ∀ s, RM.init_pre s → inv (RM.init s) := by
  sorry

theorem step_inv_proof : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  sorry

theorem hrank_proof : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
  sorry

noncomputable section

theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
  exact init_inv_proof

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  exact step_inv_proof

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [ReactiveModule.toTS, ReactiveModule.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [ReactiveModule.toTS, ReactiveModule.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

theorem hrank : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
  exact hrank_proof

def buchi := rule_buchi
  lts
  P
  inv
  hinv
  ranking
  hrank

end
