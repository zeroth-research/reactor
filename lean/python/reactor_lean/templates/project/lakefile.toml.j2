
name = "{{ project_name }}"
version = "0.1.0"
defaultTargets = ["System", "Certificate"]

# The root `Certificate.lean` imports the certificate, and through it
# every file of `Certificate/`.
[[lean_lib]]
name = "Certificate"

[[lean_lib]]
name = "System"
{% for req in requires %}

{% for line in req.comment.splitlines() %}
# {{ line }}
{% endfor %}
[[require]]
name = "{{ req.name }}"
{% if req.scope is not none %}
scope = "{{ req.scope }}"
{% endif %}
{% if req.path is not none %}
path = "{{ req.path }}"
{% else %}
{% if req.git is not none %}
git = "{{ req.git }}"
{% endif %}
rev = "{{ req.rev }}"
{% if req.sub_dir is not none %}
subDir = "{{ req.sub_dir }}"
{% endif %}
{% endif %}
{% endfor %}
{% if executable %}

[[lean_exe]]
name = "main"
root = "Main"
{% endif %}
