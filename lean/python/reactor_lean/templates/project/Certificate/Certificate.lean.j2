noncomputable section

theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
  exact init_inv_proof

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  exact step_inv_proof

{# `RM` stays folded in `hs` and `hstep`: the goal is then `inv (RM.init l)`
    or `inv (RM.update s l)`, the obligation's own statement. Unfolded, `exact`
    has to fold it back by unification, which for a 64-deep module exceeds
    the default recursion depth. #}
theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [ReactiveModule.toTS, ReactiveModule.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [ReactiveModule.toTS, ReactiveModule.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

{% if is_safety %}
-- `G P`. The invariant does the work; all that is left is that it is a
-- *strengthening* of the property. `StateSet_isInvariant` is
-- `reachableSet ⊆ ·`, so a superset of an invariant is invariant too, and
-- `rule_globally` turns that into `G (AP P)` on every trace.
theorem inv_imp_P : ∀ s, inv s → P s := by
  exact inv_imp_P_proof

theorem hP : lts.StateSet_isInvariant P := by
  intro s hs
  exact inv_imp_P s (hinv s hs)

def safety := rule_globally
  lts
  P
  hP
{% else %}
theorem hrank : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
  exact hrank_proof

def buchi := rule_buchi
  lts
  P
  inv
  hinv
  ranking
  hrank
{% endif %}

end
