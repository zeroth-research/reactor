{#- The budgets and tactics read off the module and its certificate: every
    macro the proof (`Certificate.lean.j2`) calls whose body changes with
    them. `Tactics.lean.j2` puts them in their own file; a `--cert-file`
    certificate inlines them. The proof says what each one is for, and the
    file that calls `cert_budgets` is elaborated under its budgets.

    The plan's macros name no definition of the project's, so they can be
    defined before any of it. `simp_mat` and `simp_defs` name them all,
    `RM` among them, which the proof defines after this file: the two are
    unhygienic, so each name is looked up where the macro is used. -#}
{{ plan.why() }}

macro "cert_budgets" : command =>
  `(set_option maxRecDepth {{ plan.max_rec_depth }}
    set_option maxHeartbeats {{ plan.max_heartbeats }})

set_option hygiene false in
macro "simp_mat" : tactic =>
  `(tactic| simp [{{ all_defs }}, {{ mat_simp }}])

set_option hygiene false in
macro "simp_defs" : tactic =>
  `(tactic| (simp only [{{ all_defs }}] at *; try dsimp at *))

macro "cert_prep" : tactic =>
  `(tactic| ({{ plan.prep_tactic }}))

macro "cert_close" v:ident : tactic =>
  `(tactic| {{ plan.close_tactic }})

macro "cert_states" v:ident : tactic =>
  `(tactic| ({{ plan.state_case_tactic }}))

macro "cert_facts" v:ident : tactic =>
  `(tactic| ({{ plan.facts_tactic }}))

macro "cert_floors" v:ident : tactic =>
  `(tactic| ({{ plan.floor_tactic }}))

macro "cert_thin" : tactic =>
  `(tactic| ({{ plan.clear_tactic }}))
