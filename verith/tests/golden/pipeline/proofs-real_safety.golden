=== Certificate/Proofs.lean
import Relational.Basic
import Certificate.Module
import Mathlib.Algebra.BigOperators.Fin
import ZerothHammer

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

set_option maxRecDepth 4500
set_option maxHeartbeats 2000000

-- state: Real, 1 slot(s), 3 term(s)
-- predicates: flat, linear

-- Unfold the definitions and reduce the matrix arithmetic, on the goal
-- only: on the hypotheses too it blows up exponentially.
macro "simp_mat" : tactic =>
  `(tactic| simp [RM, init, update, inv, init_pre, update_pre, P, c0, c1, MatAdd_apply, MatMul_apply, MatZero_apply, Pi.add_apply, mul_Mat_apply, add_Mat_apply, Bool.or_eq_true, decide_eq_true_eq, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Fin.sum_univ_one, Fin.sum_univ_two, Fin.sum_univ_three, matVecAffine, dotL, List.ofFn_succ, List.ofFn_zero, matMin, matMax, argmax_1d, argmax])

-- Unfold the definitions everywhere (cheap: no matrix arithmetic), so the
-- closers see the invariant's conditions.
macro "simp_defs" : tactic =>
  `(tactic| (simp only [RM, init, update, inv, init_pre, update_pre, P, c0, c1] at *; try dsimp at *))

theorem init_inv_proof : ∀ s, RM.init_pre s → inv (RM.init s) := by
  intro s hpre
  try simp_mat
  try simp_defs
  all_goals (((try norm_num at *)) <;> (first
      | contradiction
      | linarith
      | (norm_cast; linarith)
      | (norm_num; done)
      | (constructor <;> first | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; linarith)
      | (simp_all; norm_num; done)
      | lra_close
      | fail "none of the 10 closers proved this goal"))

theorem step_inv_proof : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  intro s e ⟨hpre, hinv⟩
  try simp_defs
  try simp_mat
  all_goals (((try norm_num at *)) <;> (first
      | contradiction
      | linarith
      | (norm_cast; linarith)
      | (norm_num; done)
      | (constructor <;> first | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; linarith)
      | (simp_all; norm_num; done)
      | lra_close
      | fail "none of the 10 closers proved this goal"))

theorem inv_imp_P_proof : ∀ s, inv s → P s := by
  intro s hi
  try simp_defs
  try simp_mat
  all_goals (((try norm_num at *)) <;> (first
      | contradiction
      | linarith
      | (norm_cast; linarith)
      | (norm_num; done)
      | (constructor <;> first | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; linarith)
      | (simp_all; norm_num; done)
      | lra_close
      | fail "none of the 10 closers proved this goal"))

=== standalone
import Relational.Basic
import Relational.Box
import Mathlib.Algebra.BigOperators.Fin
import ZerothHammer

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

set_option maxRecDepth 4500
set_option maxHeartbeats 2000000

/- Concrete constants -/

@[simp, reducible] noncomputable def c0 : (Mat Real 1 1) := fun _ _ => (5 : Real)

@[simp, reducible] noncomputable def c1 : (Mat Real 1 1) := fun _ _ => (1 : Real)


@[simp] noncomputable def init (extl_n: Unit) : (Mat Real 1 1) :=
  let x0 : (Mat Real 1 1) := c0
  x0

@[simp] noncomputable def update (ctrl: (Mat Real 1 1)) (extl_l: Unit) (extl_n: Unit) : (Mat Real 1 1) :=
  let x0 : (Mat Real 1 1) := c1
  let x1 : (Mat Real 1 1) := (ctrl - x0)
  x1


def init_pre (e : (Unit) × (Unit)) : Prop := True

def update_pre (e : (Unit) × (Unit)) : Prop := True

def inv : (Mat Real 1 1) → Prop := fun s => ((s 0 0) ≤ (5 : Real))

def P : (Mat Real 1 1) → Prop := fun s => ((s 0 0) ≤ (5 : Real))

noncomputable instance : DecidablePred P := fun s => by unfold P; first | infer_instance | dsimp; infer_instance

noncomputable section

def RM := ({
    init := fun e => init e.2
    update := fun x e => update x e.1 e.2
    init_pre := init_pre
    update_pre := update_pre
} : ReactiveModule _ _)

def lts := RM.toTS

end

-- state: Real, 1 slot(s), 3 term(s)
-- predicates: flat, linear

-- Unfold the definitions and reduce the matrix arithmetic, on the goal
-- only: on the hypotheses too it blows up exponentially.
macro "simp_mat" : tactic =>
  `(tactic| simp [RM, init, update, inv, init_pre, update_pre, P, c0, c1, MatAdd_apply, MatMul_apply, MatZero_apply, Pi.add_apply, mul_Mat_apply, add_Mat_apply, Bool.or_eq_true, decide_eq_true_eq, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Fin.sum_univ_one, Fin.sum_univ_two, Fin.sum_univ_three, matVecAffine, dotL, List.ofFn_succ, List.ofFn_zero, matMin, matMax, argmax_1d, argmax])

-- Unfold the definitions everywhere (cheap: no matrix arithmetic), so the
-- closers see the invariant's conditions.
macro "simp_defs" : tactic =>
  `(tactic| (simp only [RM, init, update, inv, init_pre, update_pre, P, c0, c1] at *; try dsimp at *))

theorem init_inv_proof : ∀ s, RM.init_pre s → inv (RM.init s) := by
  intro s hpre
  try simp_mat
  try simp_defs
  all_goals (((try norm_num at *)) <;> (first
      | contradiction
      | linarith
      | (norm_cast; linarith)
      | (norm_num; done)
      | (constructor <;> first | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; linarith)
      | (simp_all; norm_num; done)
      | lra_close
      | fail "none of the 10 closers proved this goal"))

theorem step_inv_proof : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  intro s e ⟨hpre, hinv⟩
  try simp_defs
  try simp_mat
  all_goals (((try norm_num at *)) <;> (first
      | contradiction
      | linarith
      | (norm_cast; linarith)
      | (norm_num; done)
      | (constructor <;> first | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; linarith)
      | (simp_all; norm_num; done)
      | lra_close
      | fail "none of the 10 closers proved this goal"))

theorem inv_imp_P_proof : ∀ s, inv s → P s := by
  intro s hi
  try simp_defs
  try simp_mat
  all_goals (((try norm_num at *)) <;> (first
      | contradiction
      | linarith
      | (norm_cast; linarith)
      | (norm_num; done)
      | (constructor <;> first | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; linarith)
      | (simp_all; norm_num; done)
      | lra_close
      | fail "none of the 10 closers proved this goal"))

noncomputable section

theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
  exact init_inv_proof

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  exact step_inv_proof

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [RM, ReactiveModule.toTS, ReactiveModule.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [RM, ReactiveModule.toTS, ReactiveModule.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

-- `G P`. The invariant does the work; all that is left is that it is a
-- *strengthening* of the property. `StateSet_isInvariant` is
-- `reachableSet ⊆ ·`, so a superset of an invariant is invariant too, and
-- `rule_globally` turns that into `G (AP P)` on every trace.
theorem inv_imp_P : ∀ s, inv s → P s := by
  exact inv_imp_P_proof

theorem hP : lts.StateSet_isInvariant P := by
  intro s hs
  exact inv_imp_P s (hinv s hs)

def safety := rule_globally
  lts
  P
  hP

end
