=== Certificate/Proofs.lean
import Relational.ReactiveTS
import Relational.ProofRules
import Certificate.Module
import Mathlib.Algebra.BigOperators.Fin
import ZerothHammer

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

set_option maxRecDepth 13500
set_option maxHeartbeats 2000000

-- state: Bool+Int, 1 slot(s), 9 term(s)
-- predicates: branching, nonlinear

-- Unfold the definitions and reduce the matrix arithmetic, on the goal
-- only: on the hypotheses too it blows up exponentially.
macro "simp_mat" : tactic =>
  `(tactic| simp [RM, init, update, inv, init_pre, update_pre, P, ranking, zero_Matrix_apply, mul_Matrix_apply, add_Matrix_apply, ↓Matrix.mk_apply, Bool.or_eq_true, decide_eq_true_eq, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Fin.sum_univ_one, Fin.sum_univ_two, Fin.sum_univ_three, matVecAffine, dotL, List.ofFn_succ, List.ofFn_zero, matMin, matMax, argmax_1d, argmax])

-- Unfold the definitions everywhere (cheap: no matrix arithmetic), so the
-- closers see the invariant's conditions.
macro "simp_defs" : tactic =>
  `(tactic| (simp only [RM, init, update, inv, init_pre, update_pre, P, ranking] at *; try dsimp [-Matrix.add_apply, -Matrix.sub_apply, -Matrix.neg_apply, -Matrix.zero_apply, -Matrix.transpose_apply] at *))

theorem init_inv_proof : ∀ s, RM.init_pre s → inv (RM.init s) := by
  intro s hpre
  try simp_mat
  try simp_defs
  all_goals (((try split_ifs) <;> (try simp only [← ne_eq, ne_iff_lt_or_gt] at *) <;> (try casesm* _ ∧ _, _ ∨ _)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | nlinarith
      | positivity
      | (constructor <;> first | omega | linarith | nlinarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (simp_all; nlinarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | (simp only [max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | (zify; simp only [Int.toNat_eq_max, max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | lia
      | fail "none of the 17 closers proved this goal"))

theorem step_inv_proof : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  intro s e ⟨hpre, hinv⟩
  try simp_defs
  try simp_mat
  all_goals (((try split_ifs) <;> (try simp only [← ne_eq, ne_iff_lt_or_gt] at *) <;> (try casesm* _ ∧ _, _ ∨ _)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | nlinarith
      | positivity
      | (constructor <;> first | omega | linarith | nlinarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (simp_all; nlinarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | (simp only [max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | (zify; simp only [Int.toNat_eq_max, max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | lia
      | fail "none of the 17 closers proved this goal"))

theorem hrank_proof : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
  intro s s' ⟨hi, hP, htr⟩
  unfold lts at htr; simp only [RM, ReactiveTS.toTS, ReactiveTS.TS_update] at htr
  obtain ⟨l, hpre, heq⟩ := htr
  rw [← heq]
  clear heq
  try simp_defs
  try simp_mat
  all_goals (((try split_ifs) <;> (try simp only [← ne_eq, ne_iff_lt_or_gt] at *) <;> (try casesm* _ ∧ _, _ ∨ _)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | nlinarith
      | positivity
      | (constructor <;> first | omega | linarith | nlinarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (simp_all; nlinarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | (simp only [max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | (zify; simp only [Int.toNat_eq_max, max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | lia
      | fail "none of the 17 closers proved this goal"))

=== standalone
import Relational.ReactiveTS
import Relational.ProofRules
import Mathlib.Algebra.BigOperators.Fin
import ZerothHammer

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

set_option maxRecDepth 13500
set_option maxHeartbeats 2000000



@[simp] def init (extl_n: Unit) : (Matrix (Fin 1) (Fin 1) Int) :=
  let x0 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (100 : Int))
  let x1 : (Matrix (Fin 1) (Fin 1) Int) := x0
  x1

@[simp] def update (ctrl: (Matrix (Fin 1) (Fin 1) Int)) (extl_l: Unit) (extl_n: Unit) : (Matrix (Fin 1) (Fin 1) Int) :=
  let x0 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (0 : Int))
  let x1 : (Matrix (Fin 1) (Fin 1) Bool) := (Matrix.mk fun _ _ => decide (ctrl 0 0 = x0 0 0))
  let x2 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (100 : Int))
  let x3 : (Matrix (Fin 1) (Fin 1) Int) := (Matrix.mk fun _ _ => (1 : Int))
  let x4 : (Matrix (Fin 1) (Fin 1) Int) := (ctrl - x3)
  let x5 : (Matrix (Fin 1) (Fin 1) Int) := (if x1 0 0 then x2 else x4)
  let x6 : (Matrix (Fin 1) (Fin 1) Int) := x5
  x6


def init_pre (e : (Unit) × (Unit)) : Prop := True

def update_pre (e : (Unit) × (Unit)) : Prop := True

def inv : (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => (s 0 0) ≥ 0

def P : (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => ((s 0 0) = (0 : Int))

instance : DecidablePred P := fun s => by unfold P; first | infer_instance | dsimp; infer_instance

def ranking : (Matrix (Fin 1) (Fin 1) Int) → Nat := fun s => ((s 0 0) * (s 0 0)).toNat

noncomputable section

def RM := ({
    init := fun e => init e.2
    update := fun x e => update x e.1 e.2
    init_pre := init_pre
    update_pre := update_pre
} : ReactiveTS _ _)

def lts := RM.toTS

end

-- state: Bool+Int, 1 slot(s), 9 term(s)
-- predicates: branching, nonlinear

-- Unfold the definitions and reduce the matrix arithmetic, on the goal
-- only: on the hypotheses too it blows up exponentially.
macro "simp_mat" : tactic =>
  `(tactic| simp [RM, init, update, inv, init_pre, update_pre, P, ranking, zero_Matrix_apply, mul_Matrix_apply, add_Matrix_apply, ↓Matrix.mk_apply, Bool.or_eq_true, decide_eq_true_eq, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Fin.sum_univ_one, Fin.sum_univ_two, Fin.sum_univ_three, matVecAffine, dotL, List.ofFn_succ, List.ofFn_zero, matMin, matMax, argmax_1d, argmax])

-- Unfold the definitions everywhere (cheap: no matrix arithmetic), so the
-- closers see the invariant's conditions.
macro "simp_defs" : tactic =>
  `(tactic| (simp only [RM, init, update, inv, init_pre, update_pre, P, ranking] at *; try dsimp [-Matrix.add_apply, -Matrix.sub_apply, -Matrix.neg_apply, -Matrix.zero_apply, -Matrix.transpose_apply] at *))

theorem init_inv_proof : ∀ s, RM.init_pre s → inv (RM.init s) := by
  intro s hpre
  try simp_mat
  try simp_defs
  all_goals (((try split_ifs) <;> (try simp only [← ne_eq, ne_iff_lt_or_gt] at *) <;> (try casesm* _ ∧ _, _ ∨ _)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | nlinarith
      | positivity
      | (constructor <;> first | omega | linarith | nlinarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (simp_all; nlinarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | (simp only [max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | (zify; simp only [Int.toNat_eq_max, max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | lia
      | fail "none of the 17 closers proved this goal"))

theorem step_inv_proof : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  intro s e ⟨hpre, hinv⟩
  try simp_defs
  try simp_mat
  all_goals (((try split_ifs) <;> (try simp only [← ne_eq, ne_iff_lt_or_gt] at *) <;> (try casesm* _ ∧ _, _ ∨ _)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | nlinarith
      | positivity
      | (constructor <;> first | omega | linarith | nlinarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (simp_all; nlinarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | (simp only [max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | (zify; simp only [Int.toNat_eq_max, max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | lia
      | fail "none of the 17 closers proved this goal"))

theorem hrank_proof : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
  intro s s' ⟨hi, hP, htr⟩
  unfold lts at htr; simp only [RM, ReactiveTS.toTS, ReactiveTS.TS_update] at htr
  obtain ⟨l, hpre, heq⟩ := htr
  rw [← heq]
  clear heq
  try simp_defs
  try simp_mat
  all_goals (((try split_ifs) <;> (try simp only [← ne_eq, ne_iff_lt_or_gt] at *) <;> (try casesm* _ ∧ _, _ ∨ _)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | nlinarith
      | positivity
      | (constructor <;> first | omega | linarith | nlinarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (simp_all; nlinarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | (simp only [max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | (zify; simp only [Int.toNat_eq_max, max_def, min_def] at *; split_ifs at * <;> (repeat' apply And.intro) <;> nlinarith)
      | lia
      | fail "none of the 17 closers proved this goal"))

noncomputable section

theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
  exact init_inv_proof

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  exact step_inv_proof

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [ReactiveTS.toTS, ReactiveTS.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [ReactiveTS.toTS, ReactiveTS.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

theorem hrank : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
  exact hrank_proof

def buchi := rule_buchi
  lts
  P
  inv
  hinv
  ranking
  hrank

end
