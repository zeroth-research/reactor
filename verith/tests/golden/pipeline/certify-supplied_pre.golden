import Relational.ReactiveTS
import Relational.ProofRules

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

def init_pre : ((Matrix (Fin 1) (Fin 1) Int)) × ((Matrix (Fin 1) (Fin 1) Int)) → Prop := fun e => ((e.2 0 0) ≥ (0 : Int))

def update_pre : ((Matrix (Fin 1) (Fin 1) Int)) × ((Matrix (Fin 1) (Fin 1) Int)) → Prop := fun e => ((e.2 0 0) ≥ (0 : Int))

def inv : (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => ((s 0 0) ≥ (0 : Int))

def P : (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => ((s 0 0) ≥ (0 : Int))

instance : DecidablePred P := fun s => by unfold P; first | infer_instance | dsimp; infer_instance


=== Certificate/Module.lean
import Relational.ReactiveTS
import Relational.ProofRules
import System.System
import Certificate.Data

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

noncomputable section

def RM := ({
    init := fun e => init e.2
    update := fun x e => update x e.1 e.2
    init_pre := init_pre
    update_pre := update_pre
} : ReactiveTS _ _)

def lts := RM.toTS

end

=== Certificate/Proofs.lean
import Relational.ReactiveTS
import Relational.ProofRules
import Certificate.Module
import Mathlib.Algebra.BigOperators.Fin
import ZerothHammer

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

set_option maxRecDepth 10500
set_option maxHeartbeats 2000000

-- state: Bool+Int, 2 slot(s), 7 term(s)
-- predicates: branching, linear
-- cvc5: no refutation needed the precondition: clearing it
-- cvc5: step_inv: the core needs only goal, inv of 3

-- Unfold the definitions and reduce the matrix arithmetic, on the goal
-- only: on the hypotheses too it blows up exponentially.
macro "simp_mat" : tactic =>
  `(tactic| simp [RM, init, update, inv, init_pre, update_pre, P, zero_Matrix_apply, mul_Matrix_apply, add_Matrix_apply, ↓Matrix.mk_apply, Bool.or_eq_true, decide_eq_true_eq, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Fin.sum_univ_one, Fin.sum_univ_two, Fin.sum_univ_three, matVecAffine, dotL, List.ofFn_succ, List.ofFn_zero, matMin, matMax, argmax_1d, argmax])

-- Unfold the definitions everywhere (cheap: no matrix arithmetic), so the
-- closers see the invariant's conditions.
macro "simp_defs" : tactic =>
  `(tactic| (simp only [RM, init, update, inv, init_pre, update_pre, P] at *; try dsimp [-Matrix.add_apply, -Matrix.sub_apply, -Matrix.neg_apply, -Matrix.zero_apply, -Matrix.transpose_apply] at *))

theorem init_inv_proof : ∀ s, RM.init_pre s → inv (RM.init s) := by
  intro s hpre
  try simp_mat
  try simp_defs
  all_goals (((try split_ifs)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | (constructor <;> first | omega | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | lia
      | fail "none of the 12 closers proved this goal"))

theorem step_inv_proof : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  intro s e ⟨hpre, hinv⟩
  clear hpre
  try simp_defs
  try simp_mat
  all_goals (((try split_ifs)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | (constructor <;> first | omega | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | lia
      | fail "none of the 12 closers proved this goal"))

theorem inv_imp_P_proof : ∀ s, inv s → P s := by
  intro s hi
  try simp_defs
  try simp_mat
  all_goals (((try split_ifs)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | (constructor <;> first | omega | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | lia
      | fail "none of the 12 closers proved this goal"))

=== Certificate/Certificate.lean
import Relational.ReactiveTS
import Relational.ProofRules
import Certificate.Module
import Certificate.Proofs

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

noncomputable section

theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
  exact init_inv_proof

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  exact step_inv_proof

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [ReactiveTS.toTS, ReactiveTS.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [ReactiveTS.toTS, ReactiveTS.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

-- `G P`. The invariant does the work; all that is left is that it is a
-- *strengthening* of the property. `StateSet_isInvariant` is
-- `reachableSet ⊆ ·`, so a superset of an invariant is invariant too, and
-- `rule_globally` turns that into `G (AP P)` on every trace.
theorem inv_imp_P : ∀ s, inv s → P s := by
  exact inv_imp_P_proof

theorem hP : lts.StateSet_isInvariant P := by
  intro s hs
  exact inv_imp_P s (hinv hs)

def safety := rule_globally
  lts
  P
  hP

end

