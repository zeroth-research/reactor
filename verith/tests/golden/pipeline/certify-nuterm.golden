import Relational.Basic

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

def init_pre (e : (Unit) × (Unit)) : Prop := True

def update_pre (e : (Unit) × (Unit)) : Prop := True

def inv : (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => (((s 0 0) ≥ (0 : Int)) ∧ ((s 0 0) ≤ (100 : Int)))

def P : (Matrix (Fin 1) (Fin 1) Int) → Prop := fun s => ((s 0 0) = (0 : Int))

instance : DecidablePred P := fun s => by unfold P; first | infer_instance | dsimp; infer_instance

def ranking : (Matrix (Fin 1) (Fin 1) Int) → Nat := fun s => (((((2 : Int) * (max ((2 : Int) + (s 0 0)) (0 : Int))) + ((2 : Int) * (max ((2 : Int) * (s 0 0)) (0 : Int))) + ((2 : Int) * (max ((- (2 : Int)) * (s 0 0)) (0 : Int))) + ((2 : Int) * (max ((- (1 : Int)) + (- (s 0 0))) (0 : Int))) + ((2 : Int) * (max (- (s 0 0)) (0 : Int))) + ((2 : Int) * (max ((- (1 : Int)) + (s 0 0)) (0 : Int))) + ((2 : Int) * (max (- (1 : Int)) (0 : Int)))) : Int)).toNat

=== Certificate/Module.lean
import Relational.Basic
import System.System
import Certificate.Data

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

noncomputable section

def RM := ({
    init := fun e => init e.2
    update := fun x e => update x e.1 e.2
    init_pre := init_pre
    update_pre := update_pre
} : ReactiveModule _ _)

def lts := RM.toTS

end

=== Certificate/Proofs.lean
import Relational.Basic
import Certificate.Module
import Mathlib.Algebra.BigOperators.Fin
import ZerothHammer

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

set_option maxRecDepth 13500
set_option maxHeartbeats 2000000

-- state: Bool+Int, 1 slot(s), 9 term(s)
-- predicates: branching, conjunctive, linear, 7 branch point(s) (0 distinct)


-- Unfold the definitions and reduce the matrix arithmetic, on the goal
-- only: on the hypotheses too it blows up exponentially.
macro "simp_mat" : tactic =>
  `(tactic| simp [RM, init, update, inv, init_pre, update_pre, P, ranking, zero_Matrix_apply, mul_Matrix_apply, add_Matrix_apply, ↓Matrix.mk_apply, Bool.or_eq_true, decide_eq_true_eq, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Fin.sum_univ_one, Fin.sum_univ_two, Fin.sum_univ_three, matVecAffine, dotL, List.ofFn_succ, List.ofFn_zero, matMin, matMax, argmax_1d, argmax])

-- Unfold the definitions everywhere (cheap: no matrix arithmetic), so the
-- closers see the invariant's conditions.
macro "simp_defs" : tactic =>
  `(tactic| (simp only [RM, init, update, inv, init_pre, update_pre, P, ranking] at *; try dsimp [-Matrix.add_apply, -Matrix.sub_apply, -Matrix.neg_apply, -Matrix.zero_apply, -Matrix.transpose_apply] at *))

theorem init_inv_proof : ∀ s, RM.init_pre s → inv (RM.init s) := by
  intro s hpre
  try simp_mat
  try simp_defs
  all_goals (((try split_ifs) <;> (try casesm* _ ∧ _) <;> (try simp only [not_and_or] at *) <;> (try simp only [← ne_eq, ne_iff_lt_or_gt] at *) <;> (try casesm* _ ∧ _, _ ∨ _)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | (constructor <;> first | omega | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | lia
      | fail "none of the 12 closers proved this goal"))

theorem step_inv_proof : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  intro s e ⟨hpre, hinv⟩
  try simp_defs
  try simp_mat
  all_goals (((try split_ifs) <;> (try casesm* _ ∧ _) <;> (try simp only [not_and_or] at *) <;> (try simp only [← ne_eq, ne_iff_lt_or_gt] at *) <;> (try casesm* _ ∧ _, _ ∨ _)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | (constructor <;> first | omega | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | lia
      | fail "none of the 12 closers proved this goal"))

theorem hrank_proof : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
  intro s s' ⟨hi, hP, htr⟩
  unfold lts at htr; simp only [RM, ReactiveModule.toTS, ReactiveModule.TS_update] at htr
  obtain ⟨l, hpre, heq⟩ := htr
  rw [← heq]
  clear heq
  try simp_defs
  try simp_mat
  all_goals (((try split_ifs) <;> (try casesm* _ ∧ _) <;> (try simp only [not_and_or] at *) <;> (try simp only [← ne_eq, ne_iff_lt_or_gt] at *) <;> (try casesm* _ ∧ _, _ ∨ _)) <;> (first
      | omega
      | contradiction
      | linarith
      | (norm_cast; omega)
      | (norm_num; done)
      | (constructor <;> first | omega | linarith)
      | tauto
      | (simp_all; done)
      | (simp_all; omega)
      | (simp_all; linarith)
      | (split_ifs at * <;> simp_all <;> omega)
      | lia
      | fail "none of the 12 closers proved this goal"))

=== Certificate/Certificate.lean
import Relational.Basic
import Certificate.Module
import Certificate.Proofs

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false

noncomputable section

theorem init_inv : ∀ s, RM.init_pre s → inv (RM.init s) := by
  exact init_inv_proof

theorem step_inv : ∀ s e, (RM.update_pre e ∧ inv s) → inv (RM.update s e) := by
  exact step_inv_proof

theorem hinv' : lts.StateSet_isInductiveInitial inv := by
  constructor
  · intro s hs
    unfold lts at hs; simp only [ReactiveModule.toTS, ReactiveModule.TS_init] at hs
    obtain ⟨l, hpre, hl⟩ := hs
    rw [← hl]
    exact init_inv l hpre
  · intro s s' ⟨hs, l, hstep⟩
    unfold lts at hstep; simp only [ReactiveModule.toTS, ReactiveModule.TS_update] at hstep
    rw [← hstep.2]
    exact step_inv s l ⟨hstep.1, hs⟩

theorem hinv : lts.StateSet_isInvariant inv := by
  apply TS.StateSet_ind_init_is_inv lts
  exact hinv'

theorem hrank : ∀ s s', (inv s ∧ ¬(P s) ∧ (∃ l, lts.Tr s l s')) →
    ranking s' < ranking s := by
  exact hrank_proof

def buchi := rule_buchi
  lts
  P
  inv
  hinv
  ranking
  hrank

end

